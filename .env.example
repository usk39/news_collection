# YouTube Data API v3 のAPIキー (Google Cloud Consoleで発行)
# https://console.cloud.google.com/apis/credentials
# 未設定でもRSSで動画取得は可能。設定すると再生数・人気コメントまで分析できるので推奨。
YOUTUBE_API_KEY=AI

# Anthropic (Claude) APIキー。設定すると海外記事の見出しを日本語訳し、日本語要約を付けます。
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# 使用モデル・思考の深さ (省略時: claude-opus-5 / low)
# NEWS_CLAUDE_MODEL=claude-opus-5
# NEWS_CLAUDE_EFFORT=low
# 1回の実行で新たに翻訳する記事数の上限 (費用の上限)
# JA_SUMMARY_MAX_ARTICLES=150

# レポート出力先ディレクトリ (省略時は output/)
NEWS_COLLECTION_OUTPUT_DIR=output

# 翻訳キャッシュの保存先 (省略時は cache/)
NEWS_COLLECTION_CACHE_DIR=cache
